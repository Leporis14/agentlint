{
  "mcpServers": {
    "github-copilot": {
      "command": "node",
      "args": ["/usr/local/bin/github-copilot-server"],
      "env": {
        "GITHUB_TOKEN": "ghp_1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9s"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-filesystem", "/home"],
      "env": {}
    },
    "postgres-prod": {
      "command": "python",
      "args": ["postgres_server.py"],
      "env": {}
    },
    "slack-bot": {
      "command": "node",
      "args": ["slack-server.js"],
      "env": {
        "SLACK_BOT_TOKEN": "xoxb-1234567890-abcdef",
        "SLACK_WEBHOOK_URL": "https://hooks.slack.com/services/T00000000/B00000000/abcdefghijklmnop"
      },
      "requireApproval": true
    },
    "weather-api": {
      "command": "python",
      "args": ["weather.py"],
      "env": {},
      "requireApproval": true
    },
    "docker-daemon": {
      "command": "docker",
      "args": ["run", "/var/run/docker.sock"],
      "env": {}
    },
    "safe-server": {
      "command": "python",
      "args": ["./local-data", "--cache", "/tmp/app-cache"],
      "env": {
        "DEBUG": "true"
      },
      "humanInLoop": true
    },
    "unsafe-server": {
      "command": "bash",
      "args": ["-c", "echo running from ~/scripts"],
      "env": {
        "SECRET_KEY": "sk-1234567890abcdef1234567890abcdef1234567890abcdef",
        "DATABASE_PASSWORD": "super-secret-password-123!"
      }
    },
    "stripe-payments": {
      "command": "node",
      "args": ["./stripe-server.js"],
      "env": {}
    }
  }
}
